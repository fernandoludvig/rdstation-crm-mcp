{
  "name": "rdstation-crm-mcp",
  "version": "0.1.0",
  "description": "MCP server for RD Station CRM — manage contacts, deals, tasks and notes from Claude or any MCP client",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rdstation",
    "rd-station-crm",
    "crm",
    "claude",
    "ai-agent"
  ],
  "license": "MIT",
  "author": "Fernando Ludvig <fernandoludvig0@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernandoludvig/rdstation-crm-mcp.git"
  },
  "type": "module",
  "bin": {
    "rdstation-crm-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "msw": "^2.7.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
